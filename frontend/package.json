{
  "name": "guardian-frontend",
  "version": "0.5.0",
  "private": true,
  "description": "Guardian 后台管理系统前端（Vue 3 + Vite + TS，珍珠玻璃主题）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint src",
    "test:api": "node --test --experimental-strip-types src/api/__tests__/*.test.ts",
    "test:unit": "node --test --experimental-strip-types src/api/__tests__/*.test.ts src/utils/__tests__/*.test.ts src/components/__tests__/*.test.ts",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "qrcode": "1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "oxlint": "1.88.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "license": "MIT"
}
