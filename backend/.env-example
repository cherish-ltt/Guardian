# 应用基础信息
APP_NAME=guardian-backend
APP_ENV=development

# 演示账号（SEED_USERS）的初始口令，同时作为后台「新增用户」未传口令时的默认口令。
# 只作用于首次播种：账号已存在时不会覆盖其口令，改这里不会重置既有账号。
# 留空则拒绝启动；生产环境必须替换为强口令（见 README「生产环境注意事项」）。
SEED_ADMIN_PASSWORD=admin123456

# 播种的账号，格式「用户名:昵称:邮箱:部门ID」，多个账号用逗号分隔，按顺序取用户 ID 1..=N。
# 不设置时使用内置的三个演示账号：
#   admin:陈立诚:chenlc@example.com:5,linjh:林嘉豪:linjh@example.com:5,heyj:何雅静:heyj@example.com:6
# 第一个账号会被授予超级管理员角色（拥有全部菜单）；超过三个的账号不分配角色与岗位。
# SEED_USERS=

# Web 服务监听配置
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# SeaORM 数据库连接配置
DATABASE_URL=sqlite://guardian.db?mode=rwc
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT_SECS=8
DATABASE_IDLE_SECS=60
DATABASE_SQLX_LOGGING=false

# JWT 配置
JWT_SECRET=change-me-to-a-random-string-with-at-least-32-characters
JWT_ISSUER=guardian-backend
JWT_AUDIENCE=guardian-clients
JWT_ACCESS_TOKEN_TTL_MINUTES=120

# 2FA 独立加密密钥(44个字符)：openssl rand -base64 32；留空不能绑定，启用后必须备份且保持不变
TWO_FACTOR_KEY=

# Redis 连接（验证码与登录会话撤销）
REDIS_URL=redis://127.0.0.1:6379
# 留空表示未设置密码
REDIS_PASSWORD=

# ── 基础数据缓存：字典、参数、部门树与管理菜单（Redis → SQLite） ──
# 只保证单后端实例内、经 API 成功修改后的后续请求不读旧值；多实例或直接改库不在保证内。
# 认证、用户权限、统计与导出不经过该缓存。
# 正常结果的基础存活时间（秒）。实际写入时再加 0–20% 抖动，避免同批键同时过期集中回源；
# 取值 1..=86400，为 0 或越界拒绝启动。
CACHE_TTL_SECS=300
# 空结果（null、空数组、空分页）的存活时间（秒）。用于挡住反复查询不存在的数据穿透到 SQLite，
# 必须小于等于 CACHE_TTL_SECS，为 0 或大于正常 TTL 时拒绝启动。
CACHE_NEGATIVE_TTL_SECS=15
# 单次 Redis 缓存读写的等待上限（毫秒）。超时即视为缓存不可用，回源 SQLite 并静默降级；
# 连续失败触发 1 秒熔断，熔断期间不再访问 Redis，恢复后自动重试并回填。必须大于 0。
CACHE_TIMEOUT_MS=100
# 每个实例同时回源 SQLite 的并发上限。并发缓存未命中会先合并，超出的回源请求直接返回 503，
# 用显式拒绝替代无限排队，保护 SQLite 连接池；取值 1..=64。
CACHE_MAX_LOADS=4
# 进程内登记的缓存键数量上限。达到上限后新键不再回填（仍然直接回源 SQLite），
# 防止高频参数组合把内存撑大；正常 TTL 内没有请求的键登记会自动回收。
CACHE_MAX_ENTRIES=4096
# 单个缓存值的字节上限。序列化后超过该大小的结果不回填缓存，避免大响应长期占用内存；
# 未命中时仍正常返回查询结果。必须大于 0。
CACHE_MAX_VALUE_BYTES=262144

# 日志过滤规则
LOG_FILTER=info,tower_http=info
# 日志时间格式化 UTC+8
LOG_UTC_OFFSET_HOUR=8
LOG_UTC_OFFSET_MINUTE=0
LOG_UTC_OFFSET_SECOND=0
# 日志前缀和后缀 eg. app.2026-04-22.log
LOG_FILENAME_PREFIX=app
LOG_FILENAME_SUFFIX=log
# 日志分割条件：DAILY/HOURLY/MINUTELY/WEEKLY/NEVER
LOG_ROTATION=DAILY
# 日志最大文件数量
LOG_MAX_LOG_FILES=60
# 日志文件夹目录
LOG_OUT_DIR=./log
# 日志批量写入：缓冲满 N 条触发一次落盘
LOG_BATCH_MAX_EVENTS=50
# 日志批量写入：最长 N 秒强制落盘一次
LOG_BATCH_FLUSH_INTERVAL_SECS=3

# ── 中间件容量配置 ──
# 单请求整体超时（秒），覆盖排队等待与处理，超时返回 408 统一响应
MIDDLEWARE_REQUEST_TIMEOUT_SECS=10
# 请求体最大字节数，超限返回 413
MIDDLEWARE_MAX_BODY_BYTES=2097152
# 全局最大并发处理数，超出后进入等待队列
MIDDLEWARE_MAX_CONCURRENCY=256
# 背压等待队列深度，队列满后快速返回 503
MIDDLEWARE_BACKPRESSURE_QUEUE=256
# 全局限流额度：每个周期允许的请求数，超限返回 429
MIDDLEWARE_RATE_LIMIT_REQUESTS=32768
MIDDLEWARE_RATE_LIMIT_PERIOD_SECS=1
# HSTS 响应头开关，默认跟随 APP_ENV（production 时开启）
# MIDDLEWARE_HSTS_ENABLED=false
# 允许跨域的来源白名单，逗号分隔（如 https://a.example,https://b.example）
# 留空表示不下发任何 CORS 放行头；单值 * 表示放行全部来源
MIDDLEWARE_CORS_ALLOWED_ORIGINS=

# ── 客户端保护：按真实来源 IP 限并发与请求量，同一出口共用额度 ──
# 可信反向代理网段（CIDR 或单个 IP），逗号分隔。只有直连对端落在此范围内时才采信
# X-Forwarded-For，并按信任链从右向左剥离可信代理；留空则完全忽略转发头（即使用直连对端 IP）。
# 不使用 X-Real-IP / Forwarded 兜底，转发头重复或参与解析的地址非法返回 400。
# 单值 * 表示信任所有直连对端，等于完全采信客户端自报的 X-Forwarded-For：仅用于本地调试，
# 生产环境会拒绝启动，且不得与具体条目混写。例：127.0.0.1/32,::1/128
MIDDLEWARE_TRUSTED_PROXIES=
# 单个来源 IP 同时在途的请求数上限，含全局排队阶段；超出返回 429，不猜测重试时间；必须大于 0
MIDDLEWARE_CLIENT_MAX_CONCURRENCY=32
# 单个来源 IP 在固定窗口内允许的请求数；超出返回 429 并带 Retry-After；必须大于 0
MIDDLEWARE_CLIENT_RATE_LIMIT_REQUESTS=1024
# 速率计数的固定窗口长度（秒），窗口满后计数重置；必须大于 0 且不得大于 MIDDLEWARE_CLIENT_IDLE_SECS
MIDDLEWARE_CLIENT_RATE_LIMIT_PERIOD_SECS=1
# 客户端注册表容量上限，即最多同时跟踪多少个来源 IP；注册表满时新来源返回 503，活动项不驱逐；必须大于 0
MIDDLEWARE_CLIENT_MAX_ENTRIES=16384
# 空闲来源保留期（秒），超过该时长未出现的条目被清理；必须大于 0 且不得小于速率窗口
MIDDLEWARE_CLIENT_IDLE_SECS=60
# 慢请求诊断阈值（毫秒），仅慢请求/超时/5xx 输出阶段汇总；必须大于 0
MIDDLEWARE_SLOW_REQUEST_MS=1000

# ── 离线 IP 地名库：日志页「查询属地」按钮的现查数据源 ──
# ip2region 的 xdb 路径（如 data/ip2region_v4.xdb，相对 backend 启动目录）。
# 留空表示不查库：属地一律返回「外网」，只区分本机 / 内网 / 外网。
# 库文件约 11 MiB（v6 约 36 MiB）且上游每周更新，不入库；下载方式见仓库根 docs/DEPLOYMENT.md，
# 可跑 scripts/fetch-ip-database.sh 下到 backend/data/，国内网络加 IP_DB_MIRROR 前缀。
# 配置了但文件不存在或格式不符时启动即失败，不会静默降级。
IP_LOCATION_DB_PATH=
# IPv6 地名库路径（如 data/ip2region_v6.xdb），与上一条互相独立；
# 只配其中一个时另一个协议的地址按本地网段与「外网」判定，不会回落到另一个库。
IP_LOCATION_V6_DB_PATH=
